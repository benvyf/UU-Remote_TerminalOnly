[Unit]
# StartLimit：RestartSec=3 下崩坏循环可持续 ~20 次重启/分钟，默认 StartLimit
# 永不触发 → 永久性坏配置（如非法分辨率参数）每天重启 ~2.8 万次刷爆 journal。
# 60s 内第 10 次重启即熔断进 failed，需人工介入（审查 2026-10-18）。
# 恢复：systemctl --user reset-failed uu-canvas-session.service && \
#       systemctl --user start uu-canvas-session.service
StartLimitIntervalSec=60
StartLimitBurst=10
Description=UU Remote terminal-only canvas (Xvfb display :50, vnc relay target)
# 用户级单元（安装到 bridge 用户的 ~/.config/systemd/user/）。
# bridge 的 vnc relay 以 --desktop-target :50 连接本画布；同用户访问 unix socket 无需 xauth。
# 上游 bridge 会自拉它自己的私有画布（UU 窗口渲染），本画布只作为 relay 的像素源。
# 与 terminal-only/rollback-desktop.sh 配套；回退完整桌面版时 disable 并删除本文件。
# 2026-10-13 BUG-001 修复：Restart=always —— Xvfb 干净退出(exit 0)同样是断服，
# on-failure 对其无效，曾导致 10-13 客户端下线后桥空转无法自愈。

[Service]
Type=simple
ExecStart=/usr/bin/Xvfb :50 -screen 0 1280x800x24 -nolisten tcp -noreset
Restart=always
RestartSec=3
# 无需 GUI 套件，Xvfb 常驻 ~40MB
MemoryMax=128M

[Install]
WantedBy=default.target
