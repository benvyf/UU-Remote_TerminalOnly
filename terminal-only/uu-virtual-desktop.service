[Unit]
Description=UU terminal-only virtual desktop (openbox + tint2 on :50)
# 依赖画布会话(Xvfb :50);画布不在则本单元自动退出重启
Wants=uu-canvas-session.service
After=uu-canvas-session.service

[Service]
Type=simple
ExecStart=%h/UU-Remote_TerminalOnly/terminal-only/virtual-desktop.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
